# ============================================================================
#  QRIS Gateway -- contoh konfigurasi
#  Salin ke .env lalu isi nilainya. JANGAN pernah commit berkas .env.
# ============================================================================

# --- RAHASIA (wajib) --------------------------------------------------------

# Token sesi ShopeePay Partner Portal.
# Cara ambil: login ke https://partner.shopee.co.id -> DevTools (F12) ->
# tab Network -> filter Fetch/XHR -> refresh halaman transaksi ->
# cari request "get-transaction-list" -> Request Payload ->
# data.metadata.token -> salin nilainya (biasanya diawali "B:").
SHOPEE_TOKEN=

# Kunci untuk melindungi API gateway ini sendiri. Buat yang acak dan panjang:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# QRIS statis milik merchant Anda.
# Ambil dari aplikasi ShopeePay -> Merchant Saya -> QRIS Statis -> unduh/lihat
# payload-nya. String ini diawali "00020101..." dan diakhiri CRC 4 digit.
# PENTING: harus QRIS statis TANPA nominal (tanpa tag 54).
QRIS_STATIC=

# --- SHOPEE PARTNER-WEB -----------------------------------------------------

SHOPEE_BASE_URL=https://shopeepay.shopee.co.id
SHOPEE_LIST_PATH=/merchant/v1/partner-web/get-transaction-list
SHOPEE_DETAIL_PATH=/merchant/v1/partner-web/get-transaction-detail
HTTP_TIMEOUT=20
HTTP_RETRIES=3

# --- POLLER -----------------------------------------------------------------

POLL_INTERVAL=3
POLL_LOOKBACK=120
POLL_PAGE_SIZE=50
POLL_MAX_BACKOFF=60

# --- ORDER ------------------------------------------------------------------

# Rentang kode unik yang ditambahkan ke harga dasar. Rentang ini menentukan
# berapa banyak order aktif yang boleh punya harga dasar sama; 1..999 berarti
# 999 order bersamaan per tingkat harga.
AMOUNT_SUFFIX_MIN=1
AMOUNT_SUFFIX_MAX=999

# Masa hidup QR, dalam detik.
ORDER_TTL=900

# Point of Initiation pada QRIS hasil konversi.
#   12 = tandai sebagai dinamis (disarankan, sesuai perilaku QRIS dinamis)
#   11 = pertahankan sebagai statis (perilaku implementasi lama)
POINT_OF_INITIATION=12

# Tanam nomor order ke tag 62 subtag 01 sebagai jejak audit.
EMBED_REFERENCE=true

# --- DATABASE ---------------------------------------------------------------

DATABASE=qris.db

# --- SERVER -----------------------------------------------------------------

# Default hanya localhost. Ubah ke 0.0.0.0 HANYA bila memang perlu diakses
# dari luar, dan pastikan sudah ada pembatas jaringan.
HOST=127.0.0.1
PORT=8088

# --- ALERT (opsional) -------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- PERILAKU ---------------------------------------------------------------

# Penjaga keselamatan. Jangan diubah kecuali Anda tahu konsekuensinya.
READ_ONLY=true
REQUIRE_API_KEY=true
